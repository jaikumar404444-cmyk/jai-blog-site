---
import type { Article } from '../utils/articles';
import ArticleMeta from './ArticleMeta.astro';
import { articleUrl } from '../utils/articles';

interface Props {
	article: Article;
	priority?: boolean;
}

const { article, priority = false } = Astro.props;
const { data } = article;
---

<article class="feature-story">
	<div class="feature-story__copy">
		<p class="eyebrow">{data.demo ? 'Demo feature' : 'Featured work'}</p>
		<h2 class="display-l"><a href={articleUrl(article)}>{data.title}</a></h2>
		<p class="body-l">{data.description}</p>
		<ArticleMeta article={article} />
		<a class="text-link" href={articleUrl(article)}>Read the piece</a>
	</div>
	<a class="feature-story__image" href={articleUrl(article)} tabindex="-1" aria-hidden="true">
		{data.hero ? <img src={data.hero.src} alt="" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} /> : <span />}
	</a>
</article>

<style>
	.feature-story { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(24rem, 1.1fr); gap: clamp(2rem, 7vw, 8rem); align-items: end; }
	.feature-story__copy { display: grid; gap: var(--space-3); padding-bottom: var(--space-4); }
	h2 a { text-decoration: none; }
	h2 a:hover { color: var(--color-accent); }
	.feature-story__copy .body-l { max-width: 30rem; margin: 0; }
	.feature-story__image { display: block; background: var(--color-surface); overflow: hidden; }
	.feature-story__image img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform var(--motion-editorial); }
	.feature-story:hover h2 a, .feature-story:focus-within h2 a { color: var(--color-accent); }
	@media (hover: hover) and (pointer: fine) { .feature-story:hover .feature-story__image img, .feature-story:focus-within .feature-story__image img { transform: scale(1.035); } }
	@media (max-width: 52rem) { .feature-story { grid-template-columns: 1fr; gap: var(--space-4); } .feature-story__copy { order: 2; padding-bottom: 0; } .feature-story__image { order: 1; } }
</style>
