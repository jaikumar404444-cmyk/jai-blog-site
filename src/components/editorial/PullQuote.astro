---
interface Props {
	attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="pull-quote">
	<blockquote><slot /></blockquote>
	{attribution && <figcaption>{attribution}</figcaption>}
</figure>

<style>
	.pull-quote {
		max-width: 55rem;
		margin: clamp(3rem, 8vw, 7rem) auto;
		padding: clamp(1.5rem, 4vw, 3.5rem) 0;
		border-block: var(--rule);
	}
	blockquote {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 4.25rem);
		line-height: 0.96;
		letter-spacing: -0.055em;
	}
	figcaption { margin-top: var(--space-3); color: var(--color-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
