---
import type { Article } from '../utils/articles';
import { articleTypes } from '../data/site';
import { articleUrl, formatDate } from '../utils/articles';

interface Props {
	article: Article;
	index?: number;
}

const { article, index } = Astro.props;
const { data } = article;
---

<article class="compact-story">
	{index && <span class="compact-story__number" aria-hidden="true">{String(index).padStart(2, '0')}</span>}
	<div class="compact-story__copy">
		<p class="meta">{articleTypes[data.type]} · {formatDate(data.date)}</p>
		<h3 class="heading-s"><a href={articleUrl(article)}>{data.title}</a></h3>
	</div>
	<a class="compact-story__link" href={articleUrl(article)} aria-label={`Read ${data.title}`}>↗</a>
</article>

<style>
	.compact-story { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-3); align-items: start; padding-block: var(--space-3); border-top: var(--rule); transition: color var(--motion-quick); }
	.compact-story__number { color: var(--color-faint); font-family: var(--font-display); font-size: 1.4rem; line-height: 1; }
	.compact-story__copy { display: grid; gap: var(--space-1); }
	.compact-story__copy p { margin: 0; }
	h3 a { text-decoration: none; background-image: linear-gradient(currentColor, currentColor); background-position: 0 100%; background-repeat: no-repeat; background-size: 0 1px; transition: color var(--motion-quick), background-size var(--duration-standard) var(--ease-standard); }
	h3 a:hover, h3 a:focus-visible, .compact-story:focus-within h3 a { color: var(--color-accent); background-size: 100% 1px; }
	.compact-story__link { display: grid; width: 2.75rem; min-height: 2.75rem; place-items: center; color: var(--color-accent); font-size: 1.35rem; text-decoration: none; transition: transform var(--motion-quick), color var(--motion-quick); }
	.compact-story:hover h3 a, .compact-story:focus-within h3 a { color: var(--color-accent); }
	.compact-story__link:hover, .compact-story__link:focus-visible { color: var(--color-ink); transform: translate(0.12rem, -0.12rem); }
</style>
