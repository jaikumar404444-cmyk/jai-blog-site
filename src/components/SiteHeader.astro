---
import { navigation, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/urls';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = basePath && Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) || '/' : Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
const navigationHref = (href: string) => (href === '/search' ? `${withBase('/search')}?focus=1` : withBase(href));
---

<header class="site-header">
	<div class="header-inner">
		<a class="wordmark" href={withBase('/')} aria-label={`${site.name}, home`}>{site.name}</a>
		<nav class="desktop-navigation" aria-label="Primary navigation">
			{navigation.map((item) => (
				<a class="nav-link" href={navigationHref(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>
		<ThemeToggle />
		<details class="mobile-navigation" data-mobile-navigation>
			<summary>Menu</summary>
			<nav aria-label="Mobile navigation">
				{navigation.map((item, index) => (
					<a class="nav-link" style={`--nav-index: ${index}`} href={navigationHref(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
				))}
				<ThemeToggle />
			</nav>
		</details>
	</div>
</header>

<script>
	const mobileNavigation = document.querySelector<HTMLDetailsElement>('[data-mobile-navigation]');

	if (mobileNavigation) {
		const menu = mobileNavigation;
		const summary = menu.querySelector('summary');
		const links = menu.querySelectorAll('a');
		let closingTimer = 0;

		function syncMenuState() {
			document.body.classList.toggle('is-menu-open', menu.open);
		}

		function finishClosing(returnFocus = false) {
			window.clearTimeout(closingTimer);
			menu.open = false;
			menu.classList.remove('is-closing');
			syncMenuState();
			if (returnFocus && summary instanceof HTMLElement) summary.focus();
		}

		function closeMenu(returnFocus = false) {
			if (!menu.open || menu.classList.contains('is-closing')) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				finishClosing(returnFocus);
				return;
			}

			menu.classList.add('is-closing');
			const panel = menu.querySelector('nav');
			panel?.addEventListener('animationend', () => finishClosing(returnFocus), { once: true });
			closingTimer = window.setTimeout(() => finishClosing(returnFocus), 600);
		}

		menu.addEventListener('toggle', syncMenuState);
		summary?.addEventListener('click', (event) => {
			if (menu.open) {
				event.preventDefault();
				closeMenu();
			}
		});
		links.forEach((link) => link.addEventListener('click', () => finishClosing()));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				event.preventDefault();
				closeMenu(true);
			}
		});
	}
</script>
