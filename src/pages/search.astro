---
import SearchInterface from '../components/SearchInterface.astro';
import Layout from '../layouts/Layout.astro';
import { articleUrl, formatDate, getPublishedArticles } from '../utils/articles';

const articles = await getPublishedArticles();
const searchItems = articles.map((article) => ({
	title: article.data.title,
	description: article.data.description,
	topic: article.data.topic,
	tags: article.data.tags,
	url: articleUrl(article),
	date: formatDate(article.data.date),
}));
---

<Layout title="Search" description="Search the JAI publication by title, description, topic, or tag.">
	<section class="search-page page-frame" aria-labelledby="search-title">
		<p class="eyebrow">Find a way in</p>
		<h1 id="search-title" class="display-l">Search</h1>
		<p class="body-l">Search across the current collection. Results update as you type.</p>
		<SearchInterface items={searchItems} />
	</section>
</Layout>

<style>
	.search-page { padding-top: var(--space-6); }
	.search-page h1 { margin-top: var(--space-3); }
	.search-page > .body-l { max-width: 40rem; margin: var(--space-4) 0 var(--space-5); }
</style>
