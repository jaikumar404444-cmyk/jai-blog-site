---
import { render, type CollectionEntry } from 'astro:content';
import ArticleMeta from '../../components/ArticleMeta.astro';
import StoryList from '../../components/StoryList.astro';
import ImageGallery from '../../components/editorial/ImageGallery.astro';
import Layout from '../../layouts/Layout.astro';
import { articleTypes } from '../../data/site';
import { getPublishedArticles, relatedArticles } from '../../utils/articles';

export async function getStaticPaths() {
	const articles = await getPublishedArticles();

	return articles.map((article) => ({
		params: { slug: article.data.slug },
		props: { article, articles },
	}));
}

interface Props {
	article: CollectionEntry<'writing'>;
	articles: CollectionEntry<'writing'>[];
}

const { article, articles } = Astro.props;
const { Content } = await render(article);
const related = relatedArticles(article, articles);
const { data } = article;
const presentation = data.layout === 'standard' && data.type === 'visual-essay' ? 'visual' : data.layout;

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: data.seoTitle ?? data.title,
	description: data.seoDescription ?? data.description,
	datePublished: data.date.toISOString(),
	mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.site ? new URL(`/writing/${data.slug}`, Astro.site).href : `/writing/${data.slug}` },
}).replace(/</g, '\\u003c');
---

<Layout title={data.seoTitle ?? data.title} description={data.seoDescription ?? data.description} image={data.socialImage ?? data.hero?.src} type="article">
	<script type="application/ld+json" set:html={jsonLd}></script>
	<article class:list={['article-page', `article-page--${presentation}`]}>
		<header class="article-header page-frame">
			<p class="eyebrow">{data.demo ? 'Demo publication' : articleTypes[data.type]}</p>
			<h1 class="display-l">{data.title}</h1>
			<p class="article-deck">{data.description}</p>
			<ArticleMeta article={article} />
		</header>

		{data.hero && (
			<figure class="article-hero page-frame">
				<img src={data.hero.src} alt={data.hero.alt} loading="eager" fetchpriority="high" />
				{(data.hero.caption || data.hero.credit) && (
					<figcaption>
						{data.hero.caption && <span>{data.hero.caption}</span>}
						{data.hero.credit && <span class="image-credit">{data.hero.credit}</span>}
					</figcaption>
				)}
			</figure>
		)}

		<div class="article-body">
			<Content />
		</div>

		{presentation === 'visual' && data.gallery && <div class="article-gallery"><ImageGallery images={data.gallery} /></div>}

		{data.references.length > 0 && (
			<section class="article-references" aria-labelledby="references-title">
				<h2 id="references-title" class="heading-s">References</h2>
				<ol>
					{data.references.map((reference) => (
						<li>
							{reference.url ? <a href={reference.url}>{reference.title}</a> : <span>{reference.title}</span>}
							{reference.author && <span> — {reference.author}</span>}
							{reference.publication && <em> ({reference.publication})</em>}
						</li>
					))}
				</ol>
			</section>
		)}

		{related.length > 0 && (
			<section class="article-related page-frame" aria-labelledby="related-title">
				<div class="article-related__heading">
					<p class="eyebrow">Continue reading</p>
					<h2 id="related-title" class="heading-l">Related work</h2>
				</div>
				<StoryList articles={related} />
			</section>
		)}
	</article>
</Layout>

<style>
	.article-header { max-width: 74rem; padding-top: var(--space-6); }
	.article-header h1 { max-width: 67rem; margin-top: var(--space-3); }
	.article-deck { max-width: 47rem; margin: var(--space-4) 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.35vw, 2.1rem); font-weight: 410; line-height: 1.18; letter-spacing: -0.04em; }
	.article-hero { margin-top: var(--space-5); animation: image-arrival 760ms 90ms var(--motion-editorial) both; }
	.article-hero img { width: 100%; max-height: 50rem; object-fit: cover; background: var(--color-surface); }
	.article-hero figcaption { display: flex; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-2); color: var(--color-muted); font-size: 0.72rem; line-height: 1.45; }
	.image-credit { flex: none; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	.article-body { width: min(100% - (var(--page-gutter) * 2), var(--reading-width)); margin: var(--space-6) auto 0; }
	.article-body :global(p) { margin: 0 0 1.5em; font-family: var(--font-display); font-size: clamp(1.16rem, 1.5vw, 1.34rem); font-weight: 410; line-height: 1.68; letter-spacing: -0.012em; }
	.article-body :global(h2), .article-body :global(h3) { margin: clamp(3.5rem, 8vw, 6rem) 0 var(--space-3); font-family: var(--font-display); font-weight: 400; letter-spacing: -0.045em; }
	.article-body :global(h2) { font-size: clamp(2rem, 3vw, 3.25rem); line-height: 0.98; }
	.article-body :global(h3) { font-size: clamp(1.5rem, 2.2vw, 2.2rem); line-height: 1.02; }
	.article-body :global(a) { color: var(--color-accent); text-decoration-thickness: 0.07em; }
	.article-body :global(blockquote) { margin: clamp(3rem, 7vw, 6rem) 0; padding: var(--space-3) 0 var(--space-3) var(--space-4); border-left: 2px solid var(--color-accent); font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.45rem); line-height: 1.08; letter-spacing: -0.04em; }
	.article-body :global(hr) { height: 1px; margin: var(--space-5) 0; border: 0; background: var(--color-rule); }
	.article-page--experimental .article-header { max-width: 90rem; text-align: center; }
	.article-page--experimental .article-deck { margin-inline: auto; }
	.article-page--experimental .article-body { max-width: 36rem; }
	.article-page--research .article-body { margin-left: max(var(--page-gutter), calc((100vw - var(--page-width)) / 2 + 28rem)); }
	.article-page--visual .article-body { max-width: 49rem; }
	.article-gallery { width: min(100% - (var(--page-gutter) * 2), 78rem); margin: 0 auto; }
	.article-references { width: min(100% - (var(--page-gutter) * 2), var(--reading-width)); margin: var(--space-5) auto 0; padding-top: var(--space-4); border-top: var(--rule); }
	.article-references h2 { margin: 0; }
	.article-references ol { display: grid; gap: var(--space-2); margin: var(--space-3) 0 0; padding-left: 1.3rem; color: var(--color-muted); font-size: 0.88rem; line-height: 1.55; }
	.article-references a { color: var(--color-accent); }
	.article-related { margin-top: var(--space-7); }
	.article-related__heading { display: flex; justify-content: space-between; gap: var(--space-3); align-items: end; padding-bottom: var(--space-4); border-bottom: var(--rule); }
	.article-related__heading p { margin: 0; }
	@media (max-width: 70rem) { .article-page--research .article-body { margin-inline: auto; } }
	@media (max-width: 38rem) { .article-hero figcaption { flex-direction: column; gap: var(--space-1); } .article-related__heading { align-items: start; flex-direction: column; } }
</style>
