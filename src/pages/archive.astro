---
import Layout from '../layouts/Layout.astro';
import { articleTypes } from '../data/site';
import { articleUrl, formatDate, getPublishedArticles } from '../utils/articles';

const articles = await getPublishedArticles();
const years = [...new Set(articles.map((article) => article.data.date.getFullYear()))].sort((a, b) => b - a);
const monthName = new Intl.DateTimeFormat('en', { month: 'long' });
---

<Layout title="Archive" description="A chronological archive of the JAI publication.">
	<section class="archive-intro page-frame" aria-labelledby="archive-title">
		<p class="eyebrow">The catalogue</p>
		<h1 id="archive-title" class="display-l">Archive</h1>
		<p class="body-l">A chronological index for returning, tracing, and finding a different entry point.</p>
	</section>

	<section class="archive-list page-frame" data-reveal aria-label="Published writing by date">
		{years.map((year) => {
			const yearArticles = articles.filter((article) => article.data.date.getFullYear() === year);
			const months = [...new Set(yearArticles.map((article) => article.data.date.getMonth()))].sort((a, b) => b - a);
			return (
				<section class="archive-year" aria-labelledby={`year-${year}`}>
					<h2 id={`year-${year}`} class="display-m">{year}</h2>
					<div class="archive-year__entries">
						{months.map((month) => (
							<section class="archive-month" aria-labelledby={`month-${year}-${month}`}>
								<h3 id={`month-${year}-${month}`} class="archive-month__title">{monthName.format(new Date(year, month, 1))}</h3>
								<ul>
									{yearArticles.filter((article) => article.data.date.getMonth() === month).map((article) => (
										<li>
											<time class="archive-date" datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
											<a href={articleUrl(article)}>{article.data.title}</a>
											<span class="meta">{articleTypes[article.data.type]} · {article.data.topic}</span>
										</li>
									))}
								</ul>
							</section>
						))}
					</div>
				</section>
			);
		})}
	</section>
</Layout>

<style>
	.archive-intro { padding-top: var(--space-6); }
	.archive-intro h1 { margin-top: var(--space-3); }
	.archive-intro .body-l { max-width: 38rem; margin: var(--space-5) 0 0; }
	.archive-list { margin-top: var(--space-6); }
	.archive-year { display: grid; grid-template-columns: minmax(10rem, 0.32fr) 1fr; gap: var(--space-5); padding-block: var(--space-5); border-top: var(--rule); }
	.archive-year__entries { display: grid; gap: var(--space-5); }
	.archive-month__title { margin: 0 0 var(--space-2); color: var(--color-muted); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
	.archive-month ul { margin: 0; padding: 0; list-style: none; border-bottom: var(--rule); }
	.archive-month li { display: grid; grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr) minmax(10rem, 0.4fr); gap: var(--space-3); align-items: baseline; padding-block: var(--space-2); border-top: var(--rule); transition: color var(--motion-quick); }
	.archive-month a { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.05; letter-spacing: -0.035em; text-decoration: none; }
	.archive-month li:hover a, .archive-month li:focus-within a { color: var(--color-accent); }
	.archive-month li:hover .archive-date, .archive-month li:hover .meta, .archive-month li:focus-within .archive-date, .archive-month li:focus-within .meta { color: var(--color-ink); }
	.archive-month .meta { text-align: right; }
	@media (max-width: 52rem) { .archive-year { grid-template-columns: 1fr; gap: var(--space-4); } .archive-month li { grid-template-columns: 1fr auto; } .archive-month a { grid-column: 1 / -1; grid-row: 1; } .archive-month .archive-date { grid-row: 2; } .archive-month .meta { grid-row: 2; text-align: right; } }
</style>
